{
  "name": "love-runner",
  "displayName": "LÖVE Runner",
  "description": "Run LÖVE 2D projects directly from VS Code with one click",
  "version": "0.1.0",
  "publisher": "bae-alves",
  "author": "bae alves",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bae-alves/ext-love"
  },
  "homepage": "https://github.com/bae-alves/ext-love",
  "bugs": {
    "url": "https://github.com/bae-alves/ext-love/issues"
  },
  "funding": {
    "type": "ko_fi",
    "url": "https://ko-fi.com/baealves"
  },
  "sponsor": {
    "url": "https://ko-fi.com/baealves"
  },
  "pix": "",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "love2d",
    "lua",
    "game",
    "gamedev",
    "workflow"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "files": [
    "out/**/*.js",
    "out/**/*.js.map",
    "media/**/*",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "love.run",
        "key": "alt+f5",
        "when": "editorLangId == 'lua' && config.love.enablePlayKey"
      }
    ],
    "configuration": {
      "title": "LÖVE Runner",
      "properties": {
        "love.binaryPath": {
          "type": "string",
          "default": "love",
          "description": "Path to the LÖVE executable (e.g. /usr/bin/love or C:\\Program Files\\LOVE\\love.exe)"
        },
        "love.enablePlayKey": {
          "type": "boolean",
          "default": true,
          "description": "Enable the default LÖVE play shortcut while editing Lua files. You can still remap it in VS Code Keyboard Shortcuts."
        }
      }
    },
    "commands": [
      {
        "command": "love.run",
        "title": "Run LÖVE Project",
        "icon": {
          "light": "media/play.svg",
          "dark": "media/play.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "love.run",
          "when": "resourceExtname == '.lua'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "love.run",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm run compile",
    "lint": "eslint src --ext ts",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.57.0",
    "typescript": "5.5.4"
  }
}
